<Page x:Class="Gui.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="RegisterPage"
      Background="Transparent">

    <Page.Resources>
        <!-- Estilo para TextBox -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#00A859"/>
            <Setter Property="CaretBrush" Value="#00A859"/>
            <Setter Property="SelectionBrush" Value="#CCF3E1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Estilo para PasswordBox -->
        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#00A859"/>
            <Setter Property="PasswordChar" Value="●"/>
            <Setter Property="SelectionBrush" Value="#CCF3E1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Estilo para etiquetas -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#00A859"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Botón primario -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#00A859"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#00C068"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#008A47"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón secundario -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#00A859"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F8FAF9"/>
                                <Setter Property="BorderBrush" Value="#00A859"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#E6F9F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <!-- Fondo con gradiente sutil -->
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FAFAFA" Offset="0"/>
                    <GradientStop Color="#F5F7F6" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <!-- Decoración de fondo -->
            <Canvas IsHitTestVisible="False" Opacity="0.35">
                <Ellipse Width="230" Height="230" Canvas.Right="-90" Canvas.Top="-80">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#CCF3E1" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Ellipse Width="170" Height="170" Canvas.Left="-60" Canvas.Bottom="-60">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#E6F9F0" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Canvas>

            <!-- Contenedor principal -->
            <StackPanel VerticalAlignment="Center" 
                        HorizontalAlignment="Stretch"
                        Margin="45,40,45,50">

                <!-- Header con icono -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,15">
                    <Border Background="#00A859"
                            Width="85"
                            Height="85"
                            CornerRadius="42.5"
                            Margin="0,0,0,25">
                        <Border.Effect>
                            <DropShadowEffect Color="#00A859" Direction="270" ShadowDepth="0" BlurRadius="20" Opacity="0.35"/>
                        </Border.Effect>
                        <TextBlock Text="📝" 
                                 FontSize="42"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="Crear Nueva Cuenta" 
                             FontSize="28" 
                             FontWeight="Bold" 
                             Foreground="#00A859"
                             HorizontalAlignment="Center"
                             Margin="0,0,0,8"/>

                    <TextBlock Text="Completa tus datos para registrarte" 
                             FontSize="15" 
                             Foreground="#6B7280"
                             HorizontalAlignment="Center"
                             TextAlignment="Center"
                             Margin="0,0,0,35"/>
                </StackPanel>

                <!-- Formulario -->
                <StackPanel MaxWidth="340">
                    <!-- Campo Identificación -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Identificación" 
                                 Style="{StaticResource LabelStyle}"/>
                        <Border x:Name="IdBorder"
                                BorderBrush="#D1D5DB"
                                BorderThickness="1.5"
                                CornerRadius="10"
                                Background="White">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="#00A859"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <TextBox x:Name="TxbId" 
                                       Style="{StaticResource ModernTextBox}"
                                       BorderThickness="0"
                                       GotFocus="TxbId_GotFocus"
                                       LostFocus="TxbId_LostFocus"
                                       KeyDown="TxbId_KeyDown"/>
                                <TextBlock Text="🆔" 
                                         FontSize="18"
                                         Foreground="#9CA3AF"
                                         IsHitTestVisible="False"
                                         VerticalAlignment="Center"
                                         HorizontalAlignment="Right"
                                         Margin="0,0,16,0"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Campo Nombre -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Nombre" 
                                 Style="{StaticResource LabelStyle}"/>
                        <Border x:Name="NombreBorder"
                                BorderBrush="#D1D5DB"
                                BorderThickness="1.5"
                                CornerRadius="10"
                                Background="White">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="#00A859"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <TextBox x:Name="txbNom" 
                                       Style="{StaticResource ModernTextBox}"
                                       BorderThickness="0"
                                       GotFocus="TxbNom_GotFocus"
                                       LostFocus="TxbNom_LostFocus"
                                       KeyDown="TxbNom_KeyDown"/>
                                <TextBlock Text="👤" 
                                         FontSize="18"
                                         Foreground="#9CA3AF"
                                         IsHitTestVisible="False"
                                         VerticalAlignment="Center"
                                         HorizontalAlignment="Right"
                                         Margin="0,0,16,0"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Campo Apellido -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Apellido" 
                                 Style="{StaticResource LabelStyle}"/>
                        <Border x:Name="ApellidoBorder"
                                BorderBrush="#D1D5DB"
                                BorderThickness="1.5"
                                CornerRadius="10"
                                Background="White">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="#00A859"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <TextBox x:Name="txbApel" 
                                       Style="{StaticResource ModernTextBox}"
                                       BorderThickness="0"
                                       GotFocus="TxbApel_GotFocus"
                                       LostFocus="TxbApel_LostFocus"
                                       KeyDown="TxbApel_KeyDown"/>
                                <TextBlock Text="👥" 
                                         FontSize="18"
                                         Foreground="#9CA3AF"
                                         IsHitTestVisible="False"
                                         VerticalAlignment="Center"
                                         HorizontalAlignment="Right"
                                         Margin="0,0,16,0"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Campo Email -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Email" 
                                 Style="{StaticResource LabelStyle}"/>
                        <Border x:Name="EmailBorder"
                                BorderBrush="#D1D5DB"
                                BorderThickness="1.5"
                                CornerRadius="10"
                                Background="White">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="#00A859"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <TextBox x:Name="txbEmail" 
                                       Style="{StaticResource ModernTextBox}"
                                       BorderThickness="0"
                                       GotFocus="TxbEmail_GotFocus"
                                       LostFocus="TxbEmail_LostFocus"
                                       KeyDown="TxbEmail_KeyDown"/>
                                <TextBlock Text="📧" 
                                         FontSize="18"
                                         Foreground="#9CA3AF"
                                         IsHitTestVisible="False"
                                         VerticalAlignment="Center"
                                         HorizontalAlignment="Right"
                                         Margin="0,0,16,0"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Campo Contraseña -->
                    <StackPanel Margin="0,0,0,30">
                        <TextBlock Text="Contraseña" 
                                 Style="{StaticResource LabelStyle}"/>
                        <Border x:Name="ContraBorder"
                                BorderBrush="#D1D5DB"
                                BorderThickness="1.5"
                                CornerRadius="10"
                                Background="White">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="#00A859"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <PasswordBox x:Name="txbContra" 
                                           Style="{StaticResource ModernPasswordBox}"
                                           BorderThickness="0"
                                           GotFocus="TxbContra_GotFocus"
                                           LostFocus="TxbContra_LostFocus"
                                           KeyDown="TxbContra_KeyDown"/>
                                <TextBlock Text="🔒" 
                                         FontSize="18"
                                         Foreground="#9CA3AF"
                                         IsHitTestVisible="False"
                                         VerticalAlignment="Center"
                                         HorizontalAlignment="Right"
                                         Margin="0,0,16,0"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Botones -->
                    <Button Content="Registrarme"
                            Style="{StaticResource PrimaryButton}"
                            Click="RegisterButton_Click"
                            Margin="0,0,0,14"/>

                    <Button Content="Regresar"
                            Style="{StaticResource SecondaryButton}"
                            Click="BackButon_Click"/>

                    <!-- Footer -->
                    <TextBlock HorizontalAlignment="Center"
                             TextAlignment="Center"
                             Margin="0,25,0,0">
                        <Run Text="Al registrarte, aceptas nuestros" 
                             Foreground="#9CA3AF"
                             FontSize="12"/>
                        <LineBreak/>
                        <Run Text="Términos y Condiciones" 
                             Foreground="#00A859"
                             FontSize="12"
                             FontWeight="SemiBold"/>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
