<Page x:Class="Gui.PerfilPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Gui"
      mc:Ignorable="d" d:DesignWidth="800"
      Title="PerfilPage"
      Background="Transparent" Height="635">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        
        <Border Grid.Row="0" 
                Background="#2F5233"
                CornerRadius="0,0,15,15"
                Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect Color="#2F5233" Opacity="0.3" BlurRadius="15" ShadowDepth="5"/>
            </Border.Effect>
            <TextBlock Text="Mi Perfil" 
                       FontSize="32" 
                       FontWeight="Bold" 
                       Foreground="White"
                       Margin="30,20,30,20"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- Contenido Principal -->
        <Grid Grid.Row="1" Margin="20,0,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Panel Izquierdo: Foto de Perfil -->
            <Border Grid.Column="0" 
                    Background="White"
                    CornerRadius="15"
                    Padding="20"
                    Margin="0,0,15,0">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.15" BlurRadius="20" ShadowDepth="3"/>
                </Border.Effect>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">
                    <!-- Marco circular para la imagen con gradiente -->
                    <Grid Width="160" Height="160" Margin="0,10,0,25">
                        <!-- Anillo decorativo exterior -->
                        <Ellipse Width="160" Height="160">
                            <Ellipse.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#2F5233" Offset="0"/>
                                    <GradientStop Color="#4A7C59" Offset="1"/>
                                </LinearGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>

                        <!-- Marco circular para la imagen -->
                        <Border Width="150" 
                                Height="150" 
                                Background="White"
                                BorderThickness="0" 
                                CornerRadius="75">
                            <Border.Effect>
                                <DropShadowEffect Color="#2F5233" Opacity="0.4" BlurRadius="15" ShadowDepth="0"/>
                            </Border.Effect>
                            <Ellipse>
                                <Ellipse.Fill>
                                    <ImageBrush x:Name="ProfileImageBrush" 
                                              ImageSource="/imagenes/avatar3.png" 
                                              Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                            </Ellipse>
                        </Border>
                    </Grid>

                    <!-- Nombre y Rol con separador -->
                    <TextBlock Text="Juan Pérez" 
                               FontSize="26" 
                               FontWeight="Bold" 
                               Foreground="#2F5233"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>

                    <Border Height="2" 
                            Width="100"
                            Margin="0,0,0,10">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="Transparent" Offset="0"/>
                                <GradientStop Color="#4A7C59" Offset="0.5"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <TextBlock Text="Operario Agrícola" 
                               FontSize="15" 
                               Foreground="#7F8C8D"
                               HorizontalAlignment="Center"
                               FontWeight="Medium"/>

                    <!-- Badge decorativo -->
                    <Border Background="#E8F5E9"
                            CornerRadius="12"
                            Padding="15,8"
                            Margin="0,20,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#4A7C59" Margin="0,0,8,0"/>
                            <TextBlock Text="Activo" 
                                       FontSize="13" 
                                       Foreground="#2F5233"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Panel Derecho: Información -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Información Personal -->
                <Border Grid.Row="0" 
                        Background="White"
                        CornerRadius="15" 
                        Padding="25">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.15" BlurRadius="20" ShadowDepth="3"/>
                    </Border.Effect>

                    <StackPanel>
                        <!-- Header con icono -->
                        <Border Background="#E8F5E9"
                                CornerRadius="10"
                                Padding="15,10"
                                Margin="0,0,0,20">
                            <TextBlock FontSize="18" 
                                       FontWeight="Bold" 
                                       Foreground="#2F5233">
                                <Run Text="📋"/>
                                <Run Text=" Información Personal"/>
                            </TextBlock>
                        </Border>

                        <!-- Nombre Completo -->
                        <Border BorderBrush="#E8F5E9" 
                                BorderThickness="0,0,0,1" 
                                Padding="0,0,0,12"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Nombre Completo" 
                                           FontSize="12" 
                                           Foreground="#95A5A6"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,6"/>
                                <TextBlock Text="Juan Perez" 
                                           FontSize="15" 
                                           Foreground="#2C3E50"
                                           FontWeight="Medium"/>
                            </StackPanel>
                        </Border>

                        <!-- Email -->
                        <Border BorderBrush="#E8F5E9" 
                                BorderThickness="0,0,0,1" 
                                Padding="0,0,0,12"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Email" 
                                           FontSize="12" 
                                           Foreground="#95A5A6"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,6"/>
                                <TextBlock Text="juan.perez@agrosmart.com" 
                                           FontSize="15" 
                                           Foreground="#2C3E50"
                                           FontWeight="Medium"/>
                            </StackPanel>
                        </Border>

                        
                       
                    </StackPanel>
                </Border>

                <!-- Detalles de Cuenta -->
                <Border Grid.Row="2" 
                        Background="White"
                        CornerRadius="15" 
                        Padding="25">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.15" BlurRadius="20" ShadowDepth="3"/>
                    </Border.Effect>

                    <StackPanel>
                        <!-- Header con icono -->
                        <Border Background="#E8F5E9"
                                CornerRadius="10"
                                Padding="15,10"
                                Margin="0,0,0,20">
                            <TextBlock FontSize="18" 
                                       FontWeight="Bold" 
                                       Foreground="#2F5233">
                                <Run Text="⚙️"/>
                                <Run Text=" Detalles de Cuenta"/>
                            </TextBlock>
                        </Border>

                        <!-- Rol -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Rol" 
                                       FontSize="13" 
                                       Foreground="#95A5A6"
                                       FontWeight="SemiBold"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"/>
                            <Border Grid.Column="1"
                                    Background="#E8F5E9"
                                    CornerRadius="8"
                                    Padding="12,6">
                                <TextBlock Text="+78 901 234" 
                                           FontSize="14" 
                                           Foreground="#2F5233"
                                           FontWeight="Medium"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <!-- Ubicación -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Ubicación" 
                                       FontSize="13" 
                                       Foreground="#95A5A6"
                                       FontWeight="SemiBold"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"/>
                            <Border Grid.Column="1"
                                    Background="#E8F5E9"
                                    CornerRadius="8"
                                    Padding="12,6">
                                <TextBlock Text="España 🗺️" 
                                           FontSize="14" 
                                           Foreground="#2F5233"
                                           FontWeight="Medium"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <!-- ID -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ID" 
                                       FontSize="13" 
                                       Foreground="#95A5A6"
                                       FontWeight="SemiBold"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"/>
                            <Border Grid.Column="1"
                                    Background="#E8F5E9"
                                    CornerRadius="8"
                                    Padding="12,6">
                                <TextBlock Text="Colombia" 
                                           FontSize="14" 
                                           Foreground="#2F5233"
                                           FontWeight="Medium"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <!-- País -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="País" 
                                       FontSize="13" 
                                       Foreground="#95A5A6"
                                       FontWeight="SemiBold"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"/>
                            <Border Grid.Column="1"
                                    Background="#E8F5E9"
                                    CornerRadius="8"
                                    Padding="12,6">
                                <TextBlock Text="Colombia" 
                                           FontSize="14" 
                                           Foreground="#2F5233"
                                           FontWeight="Medium"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
