<Page x:Class="Gui.MenuPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="MenuPage"
      Background="Transparent">

    <Page.Resources>
        <!-- Botón primario -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#00A859"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#00C068"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#008A47"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón secundario -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#00A859"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#00A859"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E6F9F0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#CCF3E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <!-- Fondo con gradiente sutil -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FAFAFA" Offset="0"/>
                <GradientStop Color="#F5F7F6" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Decoración de fondo sutil -->
        <Canvas IsHitTestVisible="False" Opacity="0.3">
            <Ellipse Width="220" Height="220" Canvas.Right="-80" Canvas.Top="-70">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#CCF3E1" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Ellipse Width="160" Height="160" Canvas.Left="-50" Canvas.Bottom="-50">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#E6F9F0" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <!-- Contenido principal -->
        <StackPanel VerticalAlignment="Center" 
                    HorizontalAlignment="Center"
                    Margin="40">

            <!-- Icono de bienvenida -->
            <Border Background="#00A859"
                    Width="90"
                    Height="90"
                    CornerRadius="45"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,30">
                <Border.Effect>
                    <DropShadowEffect Color="#00A859" 
                                    Direction="270" 
                                    ShadowDepth="0" 
                                    BlurRadius="25" 
                                    Opacity="0.35"/>
                </Border.Effect>
                <TextBlock Text="👋" 
                         FontSize="45"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>
            </Border>

            <!-- Saludo -->
            <TextBlock Text="¡Hola!" 
                     FontSize="48" 
                     FontWeight="Black" 
                     HorizontalAlignment="Center"
                     Foreground="#00A859"
                     Margin="0,0,0,8"/>

            <!-- Mensaje de bienvenida -->
            <TextBlock Text="Bienvenido a AgroSmart" 
                     FontSize="24" 
                     FontWeight="SemiBold"
                     HorizontalAlignment="Center"
                     Foreground="#00A859"
                     Margin="0,0,0,12"/>

            <!-- Descripción -->
            <TextBlock Text="Selecciona una opción para continuar" 
                     FontSize="16" 
                     HorizontalAlignment="Center"
                     Foreground="#6B7280"
                     Margin="0,0,0,45"
                     TextAlignment="Center"/>

            <!-- Botones -->
            <StackPanel Width="300">
                <!-- Botón Ingresar -->
                <Button Content="Ingresar a mi cuenta" 
                        Style="{StaticResource PrimaryButton}"
                        Click="IngresarButton_Click"
                        Margin="0,0,0,20"/>

                <!-- Separador con "o" -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" 
                            Height="1.5" 
                            Background="#D1D5DB" 
                            VerticalAlignment="Center" 
                            Margin="0,0,12,0"
                            CornerRadius="1"/>

                    <Border Grid.Column="1"
                            Background="#F3F4F6"
                            CornerRadius="12"
                            Padding="10,4">
                        <TextBlock Text="o" 
                                 Foreground="#9CA3AF" 
                                 FontSize="13"
                                 FontWeight="Medium"
                                 VerticalAlignment="Center"/>
                    </Border>

                    <Border Grid.Column="2" 
                            Height="1.5" 
                            Background="#D1D5DB" 
                            VerticalAlignment="Center" 
                            Margin="12,0,0,0"
                            CornerRadius="1"/>
                </Grid>

                <!-- Botón Crear cuenta -->
                <Button Content="Crear cuenta (registrarme)" 
                        Style="{StaticResource SecondaryButton}"
                        Click="CrearCuentaButton_Click"/>

                <!-- Información adicional -->
                <TextBlock Text="Es rápido y fácil" 
                         FontSize="13" 
                         Foreground="#9CA3AF"
                         HorizontalAlignment="Center"
                         Margin="0,15,0,0"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
