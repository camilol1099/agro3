<Page x:Class="Gui.EmpleadoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Empleado"
      Background="Transparent" Height="668">

    <Page.Resources>
        <!-- Estilo para las tarjetas de estadísticas -->
        <Style TargetType="Border" x:Key="StatsCardStyle">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="25"/>
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="2" BlurRadius="20" Opacity="0.12"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para botones -->
        <Style TargetType="Button" x:Key="ActionButtonStyle">
            <Setter Property="Background" Value="#2F5233"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#4A7C59"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1F3A22"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para headers de tabla -->
        <Style TargetType="TextBlock" x:Key="TableHeaderStyle">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2F5233"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>

        <!-- Estilo para celdas de tabla -->
        <Style TargetType="TextBlock" x:Key="TableCellStyle">
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Estilo para TextBox -->
        <Style TargetType="TextBox" x:Key="InputTextBoxStyle">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,20,30,30">

            <!-- Header de bienvenida -->
            <Border Background="Transparent" Margin="0,0,0,30">
                <StackPanel>
                    <TextBlock x:Name="WelcomeText" 
                               Text="Hola, bienvenido" 
                               FontSize="32" 
                               FontWeight="Bold" 
                               Foreground="#2F5233"
                               Margin="0,0,0,5"/>
                    <TextBlock Text="Aquí está el resumen de tus actividades"
                               FontSize="14"
                               Foreground="#7F8C8D"/>
                </StackPanel>
            </Border>

            <!-- Tarjetas de estadísticas -->
            <Grid Margin="0,0,0,35">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    
                </Grid.ColumnDefinitions>

                <!-- Tareas asignadas hoy -->
                <Border Grid.Column="0" Style="{StaticResource StatsCardStyle}">
                    <StackPanel>
                        <TextBlock Text="📋 Tareas asignadas hoy" 
                                   Foreground="#7F8C8D" 
                                   FontSize="13"
                                   Margin="0,0,0,10"/>
                          
                        <TextBlock x:Name="TareasAsignadasText" 
                                   Text="" 
                                   FontSize="42" 
                                   FontWeight="Bold" 
                                   Foreground="#2F5233"/>
                        <Border Height="3" 
                                Background="#E8F5E9"
                                CornerRadius="2"
                                Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- En progreso -->
                <Border Grid.Column="1" Style="{StaticResource StatsCardStyle}">
                    <StackPanel>
                        <TextBlock Text="⏱️ En progreso" 
                                   Foreground="#7F8C8D" 
                                   FontSize="13"
                                   Margin="0,0,0,10"/>
                        <TextBlock x:Name="EnProgresoText" 
                                   Text="0" 
                                   FontSize="42" 
                                   FontWeight="Bold" 
                                   Foreground="#4A7C59"/>
                        <Border Height="3" 
                                Background="#E8F5E9"
                                CornerRadius="2"
                                Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Vencidas -->
                <Border Grid.Column="2" Style="{StaticResource StatsCardStyle}">
                    <StackPanel>
                        <TextBlock Text="⚠️ Vencidas" 
                                   Foreground="#7F8C8D" 
                                   FontSize="13"
                                   Margin="0,0,0,10"/>
                        <TextBlock x:Name="VencidasText" 
                                   Text="0" 
                                   FontSize="42" 
                                   FontWeight="Bold" 
                                   Foreground="#E74C3C"/>
                        <Border Height="3" 
                                Background="#FADBD8"
                                CornerRadius="2"
                                Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sección de tareas -->
                <StackPanel Grid.Column="0" Margin="0,0,20,0">

                    <!-- Mis tareas pendientes -->
                    <Border Background="White"
                            CornerRadius="15"
                            Padding="25"
                            Margin="0,0,0,25">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="2" BlurRadius="20" Opacity="0.12"/>
                        </Border.Effect>

                        <StackPanel>
                            <TextBlock Text="📌 Mis tareas pendientes" 
                                       FontSize="20" 
                                       FontWeight="Bold" 
                                       Foreground="#2F5233"
                                       Margin="0,0,0,20"/>

                            <!-- Tabla de tareas pendientes -->
                            <Border Background="#F8F9FA" 
                                    CornerRadius="10"
                                    Padding="0"
                                    Margin="0,0,0,15">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Headers -->
                                    <Border Grid.Row="0" 
                                            Background="#E8F5E9"
                                            CornerRadius="10,10,0,0"
                                            Padding="5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="Código" Style="{StaticResource TableHeaderStyle}"/>
                                            <TextBlock Grid.Column="1" Text="Estado" Style="{StaticResource TableHeaderStyle}"/>
                                            <TextBlock Grid.Column="2" Text="Fecha programada" Style="{StaticResource TableHeaderStyle}"/>
                                            <TextBlock Grid.Column="3" Text="Horas acumuladas" Style="{StaticResource TableHeaderStyle}"/>
                                        </Grid>
                                    </Border>

                                    <!-- ItemsControl para datos dinámicos -->
                                    <ItemsControl Grid.Row="1" x:Name="TareasPendientesItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#E8F5E9" BorderThickness="0,0,0,1" Background="White">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0" Text="{Binding Codigo}" Style="{StaticResource TableCellStyle}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Estado}" Style="{StaticResource TableCellStyle}"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding FechaProgramada}" Style="{StaticResource TableCellStyle}"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding HorasAcumuladas}" Style="{StaticResource TableCellStyle}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>

                            <!-- Sección de entrada de datos para tareas pendientes -->
                            <TextBlock Text="Agregar nueva tarea pendiente" 
                                       FontSize="14" 
                                       FontWeight="SemiBold" 
                                       Foreground="#2F5233"
                                       Margin="0,10,0,8"/>

                            <!-- Fila 1 de TextBox - Tareas Pendientes -->
                            <Border Background="#F8F9FA" 
                                    CornerRadius="8"
                                    Padding="8"
                                    Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="txtPendCodigo1" Style="{StaticResource InputTextBoxStyle}" Margin="3"/>
                                    <TextBox Grid.Column="1" x:Name="txtPendEstado1" Style="{StaticResource InputTextBoxStyle}" Margin="3"/>
                                    <TextBox Grid.Column="2" x:Name="txtPendFecha1" Style="{StaticResource InputTextBoxStyle}" Margin="3"/>
                                    <TextBox Grid.Column="3" x:Name="txtPendHoras1" Style="{StaticResource InputTextBoxStyle}" Margin="3"/>
                                </Grid>
                            </Border>

                            <!-- Fila 2 de TextBox - Tareas Pendientes -->
                            <Border Background="#F8F9FA" 
                                    CornerRadius="8"
                                    Padding="8"
                                    Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="txtPendCodigo2" Style="{StaticResource InputTextBoxStyle}" Margin="3"/>
                                    <TextBox Grid.Column="1" x:Name="txtPendEstado2" Style="{StaticResource InputTextBoxStyle}" Margin="3"/>
                                    <TextBox Grid.Column="2" x:Name="txtPendFecha2" Style="{StaticResource InputTextBoxStyle}" Margin="3"/>
                                    <TextBox Grid.Column="3" x:Name="txtPendHoras2" Style="{StaticResource InputTextBoxStyle}" Margin="3"/>
                                </Grid>
                            </Border>

                            <!-- Fila 3 de TextBox - Tareas Pendientes -->
                            <Border Background="#F8F9FA" 
                                    CornerRadius="8"
                                    Padding="8"
                                    Margin="0,0,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="txtPendCodigo3" Style="{StaticResource InputTextBoxStyle}" Margin="3"/>
                                    <TextBox Grid.Column="1" x:Name="txtPendEstado3" Style="{StaticResource InputTextBoxStyle}" Margin="3"/>
                                    <TextBox Grid.Column="2" x:Name="txtPendFecha3" Style="{StaticResource InputTextBoxStyle}" Margin="3"/>
                                    <TextBox Grid.Column="3" x:Name="txtPendHoras3" Style="{StaticResource InputTextBoxStyle}" Margin="3"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Tareas en progreso -->
                    <Border Background="White"
                            CornerRadius="15"
                            Padding="25">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="2" BlurRadius="20" Opacity="0.12"/>
                        </Border.Effect>

                        <StackPanel>
                            <TextBlock Text="🚀 Tareas en progreso" 
                                       FontSize="20" 
                                       FontWeight="Bold" 
                                       Foreground="#2F5233"
                                       Margin="0,0,0,20"/>

                            <!-- Tabla de tareas en progreso -->
                            <Border Background="#F8F9FA" 
                                    CornerRadius="10"
                                    Padding="0"
                                    Margin="0,0,0,15">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Headers -->
                                    <Border Grid.Row="0" 
                                            Background="#E8F5E9"
                                            CornerRadius="10,10,0,0"
                                            Padding="5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="1.5*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="Código" Style="{StaticResource TableHeaderStyle}"/>
                                            <TextBlock Grid.Column="1" Text="Actividad" Style="{StaticResource TableHeaderStyle}"/>
                                            <TextBlock Grid.Column="2" Text="Cultivo" Style="{StaticResource TableHeaderStyle}"/>
                                            <TextBlock Grid.Column="3" Text="Fecha" Style="{StaticResource TableHeaderStyle}"/>
                                            <TextBlock Grid.Column="4" Text="Acción" Style="{StaticResource TableHeaderStyle}" HorizontalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- ItemsControl para datos dinámicos -->
                                    <ItemsControl Grid.Row="1" x:Name="TareasProgresoItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#E8F5E9" BorderThickness="0,0,0,1" Background="White" Padding="5">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="1.2*"/>
                                                            <ColumnDefinition Width="1.2*"/>
                                                            <ColumnDefinition Width="1.2*"/>
                                                            <ColumnDefinition Width="1.2*"/>
                                                            <ColumnDefinition Width="1.5*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0" Text="{Binding Codigo}" Style="{StaticResource TableCellStyle}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Actividad}" Style="{StaticResource TableCellStyle}"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Cultivo}" Style="{StaticResource TableCellStyle}"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding Fecha}" Style="{StaticResource TableCellStyle}"/>
                                                        <Button Grid.Column="4" 
                                                                Content="Registrar avance" 
                                                                Style="{StaticResource ActionButtonStyle}"
                                                                Tag="{Binding Codigo}"
                                                                HorizontalAlignment="Center"
                                                                Margin="5"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>

                            <!-- Sección de entrada de datos para tareas en progreso -->
                            <TextBlock Text="Agregar nueva tarea en progreso" 
                                       FontSize="14" 
                                       FontWeight="SemiBold" 
                                       Foreground="#2F5233"
                                       Margin="0,10,0,8"/>

                            <!-- Fila 1 de TextBox - Tareas en Progreso -->
                            <Border Background="#F8F9FA" 
                                    CornerRadius="8"
                                    Padding="8"
                                    Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="txtProgCodigo1" Style="{StaticResource InputTextBoxStyle}" Margin="3"/>
                                    <TextBox Grid.Column="1" x:Name="txtProgActividad1" Style="{StaticResource InputTextBoxStyle}" Margin="3"/>
                                    <TextBox Grid.Column="2" x:Name="txtProgCultivo1" Style="{StaticResource InputTextBoxStyle}" Margin="3"/>
                                    <TextBox Grid.Column="3" x:Name="txtProgFecha1" Style="{StaticResource InputTextBoxStyle}" Margin="3"/>
                                    <TextBox Grid.Column="4" x:Name="txtProgAccion1" Style="{StaticResource InputTextBoxStyle}" Margin="3"/>
                                </Grid>
                            </Border>

                            <!-- Fila 2 de TextBox - Tareas en Progreso -->
                            <Border Background="#F8F9FA" 
                                    CornerRadius="8"
                                    Padding="8"
                                    Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="txtProgCodigo2" Style="{StaticResource InputTextBoxStyle}" Margin="3"/>
                                    <TextBox Grid.Column="1" x:Name="txtProgActividad2" Style="{StaticResource InputTextBoxStyle}" Margin="3"/>
                                    <TextBox Grid.Column="2" x:Name="txtProgCultivo2" Style="{StaticResource InputTextBoxStyle}" Margin="3"/>
                                    <TextBox Grid.Column="3" x:Name="txtProgFecha2" Style="{StaticResource InputTextBoxStyle}" Margin="3"/>
                                    <TextBox Grid.Column="4" x:Name="txtProgAccion2" Style="{StaticResource InputTextBoxStyle}" Margin="3"/>
                                </Grid>
                            </Border>

                            <!-- Fila 3 de TextBox - Tareas en Progreso -->
                            <Border Background="#F8F9FA" 
                                    CornerRadius="8"
                                    Padding="8"
                                    Margin="0,0,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="txtProgCodigo3" Style="{StaticResource InputTextBoxStyle}" Margin="3"/>
                                    <TextBox Grid.Column="1" x:Name="txtProgActividad3" Style="{StaticResource InputTextBoxStyle}" Margin="3"/>
                                    <TextBox Grid.Column="2" x:Name="txtProgCultivo3" Style="{StaticResource InputTextBoxStyle}" Margin="3"/>
                                    <TextBox Grid.Column="3" x:Name="txtProgFecha3" Style="{StaticResource InputTextBoxStyle}" Margin="3"/>
                                    <TextBox Grid.Column="4" x:Name="txtProgAccion3" Style="{StaticResource InputTextBoxStyle}" Margin="3"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Panel lateral de alertas -->
                <StackPanel Grid.Column="1">
                    <Border Background="White"
                            CornerRadius="15"
                            Padding="20">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="2" BlurRadius="20" Opacity="0.12"/>
                        </Border.Effect>

                        <StackPanel>
                            <TextBlock Text="🔔 Alertas" 
                                       FontSize="18" 
                                       FontWeight="Bold" 
                                       Foreground="#2F5233"
                                       Margin="0,0,0,15"/>

                            <!-- ItemsControl para alertas dinámicas -->
                            <ItemsControl x:Name="AlertasItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FFF9E6" 
                                                BorderBrush="#FFD700" 
                                                BorderThickness="2" 
                                                CornerRadius="10" 
                                                Padding="15"
                                                Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Titulo}" 
                                                           FontWeight="SemiBold"
                                                           Foreground="#856404"
                                                           FontSize="13"
                                                           Margin="0,0,0,5"/>
                                                <TextBlock Text="{Binding Mensaje}" 
                                                           TextWrapping="Wrap" 
                                                           Foreground="#856404"
                                                           FontSize="12"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Mensaje por defecto cuando no hay alertas -->
                            <Border x:Name="NoAlertasBorder"
                                    Background="#E8F5E9" 
                                    BorderBrush="#4A7C59" 
                                    BorderThickness="2" 
                                    CornerRadius="10" 
                                    Padding="15"
                                    Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="✓" 
                                               FontSize="24"
                                               Foreground="#2F5233"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,5"/>
                                    <TextBlock Text="Todo al día" 
                                               TextWrapping="Wrap" 
                                               Foreground="#2F5233"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>

