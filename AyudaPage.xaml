<Page x:Class="Gui.AyudaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1000"
      Title="AyudaPage"
      Background="#F0F2F5">

    <Page.Resources>

        <!-- Título de sección -->
        <Style TargetType="TextBlock" x:Key="SectionTitleStyle">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2F5233"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>

        <!-- Estilo de tarjetas -->
        <Style TargetType="Border" x:Key="CardStyle">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="30"/>
            <Setter Property="Margin" Value="0,0,0,25"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000"
                                      Direction="270"
                                      ShadowDepth="2"
                                      BlurRadius="20"
                                      Opacity="0.08"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Preguntas -->
        <Style TargetType="TextBlock" x:Key="QuestionStyle">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Margin" Value="5,0"/>
        </Style>

        <!-- Respuestas -->
        <Style TargetType="TextBlock" x:Key="AnswerStyle">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="5,10,5,0"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="40">

            <!-- Encabezado principal -->
            <TextBlock Text="Centro de Ayuda y Preguntas Frecuentes (FAQ) ❓"
                       FontSize="36"
                       FontWeight="ExtraBold"
                       Foreground="#2F5233"
                       Margin="0,0,0,10"/>
            <TextBlock Text="Encuentra respuestas rápidas sobre tu perfil, tareas y funcionalidades de AgroSmart."
                       FontSize="16"
                       Foreground="#7F8C8D"
                       Margin="0,0,0,30"/>

            <!-- Sección: Perfil -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="👤 Gestión de Perfil"
                               Style="{StaticResource SectionTitleStyle}"/>

                    <Expander Header="¿Cómo subo o cambio mi foto de perfil?" Margin="0,5">
                        <Expander.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource QuestionStyle}"/>
                            </DataTemplate>
                        </Expander.HeaderTemplate>
                        <Border Background="#F9F9F9"
                                Padding="20,15"
                                CornerRadius="5">
                            <TextBlock Style="{StaticResource AnswerStyle}">
                                Dirígete a la sección **Mi Perfil**. Haz clic en el botón **Subir foto** debajo del círculo de imagen y selecciona un archivo .jpg o .png desde tu computadora.
                            </TextBlock>
                        </Border>
                    </Expander>

                    <Expander Header="¿Qué datos puedo editar en mi perfil?" Margin="0,5">
                        <Expander.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource QuestionStyle}"/>
                            </DataTemplate>
                        </Expander.HeaderTemplate>
                        <Border Background="#F9F9F9"
                                Padding="20,15"
                                CornerRadius="5">
                            <TextBlock Style="{StaticResource AnswerStyle}">
                                Puedes editar tu **Nombre**, **Apellido**, **Correo electrónico** y **Teléfono**. 
                                Campos como el **ID** o el **Rol** solo pueden ser actualizados por un administrador.
                            </TextBlock>
                        </Border>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- Sección: Tareas -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="📋 Tareas y Procesos"
                               Style="{StaticResource SectionTitleStyle}"/>

                    <Expander Header="¿Cómo registro un avance en una tarea en progreso?" Margin="0,5">
                        <Expander.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource QuestionStyle}"/>
                            </DataTemplate>
                        </Expander.HeaderTemplate>
                        <Border Background="#F9F9F9"
                                Padding="20,15"
                                CornerRadius="5">
                            <TextBlock Style="{StaticResource AnswerStyle}">
                                En la página principal (**Dashboard**), entra en la sección **Tareas en progreso**. 
                                Luego haz clic en **Registrar avance** para ingresar los detalles del trabajo realizado.
                            </TextBlock>
                        </Border>
                    </Expander>

                    <Expander Header="Mi tarea aparece como 'Vencida', ¿qué debo hacer?" Margin="0,5">
                        <Expander.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource QuestionStyle}"/>
                            </DataTemplate>
                        </Expander.HeaderTemplate>
                        <Border Background="#F9F9F9"
                                Padding="20,15"
                                CornerRadius="5">
                            <TextBlock Style="{StaticResource AnswerStyle}">
                                Comunícate con tu **Supervisor** o **Administrador** para notificar la demora y solicitar una extensión o reasignación.
                            </TextBlock>
                        </Border>
                    </Expander>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>

